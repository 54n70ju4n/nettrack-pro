{
  "name": "InstallationPoint",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre/ID del punto (ej: ETH-01, C1, AP1)"
    },
    "floor_id": {
      "type": "string"
    },
    "space_id": {
      "type": "string"
    },
    "device_type": {
      "type": "string",
      "enum": [
        "ethernet",
        "camara",
        "access_point"
      ],
      "default": "ethernet"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendiente",
        "en_proceso",
        "finalizado",
        "con_observaciones"
      ],
      "default": "pendiente"
    },
    "technician": {
      "type": "string",
      "description": "Nombre del t\u00e9cnico asignado"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "act_perforacion": {
      "type": "boolean",
      "default": false
    },
    "act_pesca_cable": {
      "type": "boolean",
      "default": false
    },
    "act_ponchado": {
      "type": "boolean",
      "default": false
    },
    "ponchado_type": {
      "type": "string",
      "enum": [
        "jack",
        "z_plug",
        "na"
      ],
      "default": "na"
    },
    "acc_face_plate": {
      "type": "boolean",
      "default": false
    },
    "acc_tapa_face_plate": {
      "type": "boolean",
      "default": false
    },
    "acc_tornillos": {
      "type": "boolean",
      "default": false
    },
    "acc_rotulo": {
      "type": "boolean",
      "default": false
    },
    "acc_protector": {
      "type": "boolean",
      "default": false
    },
    "equipo_instalado": {
      "type": "boolean",
      "default": false
    },
    "equipo_configurado": {
      "type": "boolean",
      "default": false
    },
    "equipo_probado": {
      "type": "boolean",
      "default": false
    },
    "funcionando": {
      "type": "boolean",
      "default": false
    },
    "identificado_rack": {
      "type": "boolean",
      "default": false,
      "description": "Identificado en rack"
    },
    "ponchado_rack": {
      "type": "boolean",
      "default": false,
      "description": "Ponchado en rack"
    },
    "custom_checks": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      },
      "description": "Estado de items personalizados {check_id: true/false}"
    },
    "puerto_patch_panel": {
      "type": "string"
    },
    "puerto_switch": {
      "type": "string"
    },
    "vlan": {
      "type": "string"
    },
    "observaciones": {
      "type": "string"
    },
    "evidencia": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs de fotos de evidencia"
    }
  },
  "required": [
    "name",
    "floor_id",
    "space_id",
    "device_type"
  ]
}