{
  "name": "Candidate",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Candidate full name"
    },
    "email": {
      "type": "string",
      "description": "Candidate email"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "position_applied": {
      "type": "string",
      "description": "Position applied for"
    },
    "stage": {
      "type": "string",
      "enum": [
        "new",
        "documents_pending",
        "documents_complete",
        "interview_scheduled",
        "interview_completed",
        "offer_extended",
        "hired",
        "declined",
        "withdrawn"
      ],
      "default": "new"
    },
    "document_status": {
      "type": "string",
      "enum": [
        "incomplete",
        "complete",
        "expired"
      ],
      "default": "incomplete"
    },
    "missing_documents": {
      "type": "string",
      "description": "List of missing required documents"
    },
    "background_check_status": {
      "type": "string",
      "enum": [
        "not_started",
        "pending",
        "cleared",
        "flagged",
        "expired"
      ],
      "default": "not_started"
    },
    "background_check_expiry": {
      "type": "string",
      "format": "date",
      "description": "Background check expiration date"
    },
    "certifications": {
      "type": "string",
      "description": "Certifications held and expiration dates"
    },
    "interview_notes": {
      "type": "string",
      "description": "Structured interview summary"
    },
    "interview_prep": {
      "type": "string",
      "description": "Interview prep packet content"
    },
    "interview_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the candidate's interview"
    },
    "recommendation_rating": {
      "type": "string",
      "enum": [
        "highly_recommended",
        "recommended",
        "consider",
        "not_recommended"
      ],
      "description": "Vera's recommendation rating after interview"
    },
    "recruitment_summary": {
      "type": "string",
      "description": "Vera's summary of qualifications, communication skills, experience, strengths, concerns, and overall fit"
    },
    "notes": {
      "type": "string",
      "description": "General notes"
    }
  },
  "required": [
    "full_name"
  ]
}