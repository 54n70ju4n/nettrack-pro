{
  "name": "AppointmentSlot",
  "type": "object",
  "properties": {
    "start_datetime": {
      "type": "string",
      "format": "date-time"
    },
    "end_datetime": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "Available",
        "Held",
        "Booked",
        "Unavailable"
      ],
      "default": "Available"
    },
    "created_by_user_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "start_datetime",
    "end_datetime"
  ]
}