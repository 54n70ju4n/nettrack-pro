{
  "name": "Space",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del espacio (ej: Habitaci\u00f3n 201, Pasillo)"
    },
    "floor_id": {
      "type": "string",
      "description": "ID del piso al que pertenece"
    },
    "space_type": {
      "type": "string",
      "enum": [
        "habitacion",
        "pasillo",
        "sala",
        "otro"
      ],
      "default": "habitacion"
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "floor_id"
  ]
}