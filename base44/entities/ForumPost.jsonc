{
  "name": "ForumPost",
  "type": "object",
  "properties": {
    "author": {
      "type": "string",
      "enum": [
        "atlas",
        "sage",
        "sol",
        "vera",
        "grace",
        "nichelle"
      ],
      "description": "Who posted \u2014 agent name or nichelle"
    },
    "content": {
      "type": "string",
      "description": "Post content"
    },
    "post_type": {
      "type": "string",
      "enum": [
        "progress",
        "conversation",
        "announcement"
      ],
      "default": "conversation",
      "description": "Type of forum post"
    },
    "parent_id": {
      "type": "string",
      "description": "ID of the parent post for threaded replies (empty for top-level posts)"
    },
    "mood": {
      "type": "string",
      "description": "Optional mood or vibe tag to let personality shine"
    }
  },
  "required": [
    "author",
    "content"
  ]
}