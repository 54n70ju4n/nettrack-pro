{
  "name": "SocialPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Post title or hook"
    },
    "content": {
      "type": "string",
      "description": "Full post content"
    },
    "platform": {
      "type": "string",
      "enum": [
        "linkedin",
        "instagram",
        "facebook",
        "twitter"
      ],
      "default": "linkedin"
    },
    "post_type": {
      "type": "string",
      "enum": [
        "micro_lesson",
        "myth_buster",
        "small_moment_story",
        "director_insight",
        "carousel",
        "video_script",
        "event_promo",
        "hiring_win"
      ],
      "default": "micro_lesson"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_approval",
        "approved",
        "scheduled",
        "published"
      ],
      "default": "draft"
    },
    "source_training": {
      "type": "string",
      "description": "Training module this post is derived from"
    },
    "visual_direction": {
      "type": "string",
      "description": "Visual direction for Canva pairing"
    },
    "image_url": {
      "type": "string",
      "description": "AI-generated, on-brand realistic photo for the post"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date",
      "description": "Scheduled publish date"
    },
    "performance_notes": {
      "type": "string",
      "description": "Engagement and performance notes"
    },
    "requires_individual_approval": {
      "type": "boolean",
      "default": false,
      "description": "True for date-specific or promotional posts"
    },
    "revision_notes": {
      "type": "string",
      "description": "Edit feedback from Nichelle when a post is sent back for revisions"
    }
  },
  "required": [
    "title",
    "content"
  ]
}