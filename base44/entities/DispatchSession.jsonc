{
  "name": "DispatchSession",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Unique human-readable session ID (e.g. DS-000123)"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "description": "StaffUser ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "completed"
      ],
      "default": "draft",
      "description": "draft=building, active=confirmed/visible to driver, completed=all delivered"
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When batch was confirmed and made active"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "created_at",
    "created_by",
    "status"
  ]
}