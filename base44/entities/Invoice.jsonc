{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_code": {
      "type": "string",
      "description": "e.g. INV-000789"
    },
    "sale_id": {
      "type": "string",
      "description": "FK to PalletSale"
    },
    "truck_load_id": {
      "type": "string",
      "description": "FK to TruckLoad (if invoice is for a truck load)"
    },
    "invoice_date": {
      "type": "string",
      "format": "date"
    },
    "bill_to_name": {
      "type": "string"
    },
    "bill_to_address": {
      "type": "string"
    },
    "bill_to_phone": {
      "type": "string"
    },
    "custom_header_text": {
      "type": "string"
    },
    "custom_footer_text": {
      "type": "string"
    },
    "line_items_override_json": {
      "type": "string"
    },
    "total_override": {
      "type": "number"
    },
    "pdf_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Issued"
      ],
      "default": "Draft"
    }
  },
  "required": [
    "invoice_code",
    "invoice_date",
    "status"
  ]
}