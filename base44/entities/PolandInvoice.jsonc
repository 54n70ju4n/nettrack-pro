{
  "name": "PolandInvoice",
  "type": "object",
  "properties": {
    "invoice_code": {
      "type": "string",
      "description": "e.g. PL-INV-000001"
    },
    "sale_id": {
      "type": "string",
      "description": "FK to PolandPalletSale"
    },
    "invoice_date": {
      "type": "string",
      "format": "date"
    },
    "bill_to_name": {
      "type": "string"
    },
    "bill_to_address": {
      "type": "string"
    },
    "bill_to_phone": {
      "type": "string"
    },
    "custom_header_text": {
      "type": "string"
    },
    "custom_footer_text": {
      "type": "string"
    },
    "line_items_override_json": {
      "type": "string"
    },
    "total_override": {
      "type": "number",
      "description": "EUR"
    },
    "pdf_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Issued"
      ],
      "default": "Draft"
    }
  },
  "required": [
    "invoice_code",
    "invoice_date",
    "status"
  ]
}