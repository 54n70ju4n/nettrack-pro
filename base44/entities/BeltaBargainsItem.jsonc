{
  "name": "BeltaBargainsItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Item title/description"
    },
    "product_code": {
      "type": "string",
      "description": "Product code/SKU"
    },
    "cost_price": {
      "type": "number",
      "description": "Item cost price"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Transferred"
      ],
      "default": "Pending",
      "description": "Item status"
    },
    "box_checked": {
      "type": "boolean",
      "default": false,
      "description": "Whether this item has been box-checked"
    },
    "created_by_user_id": {
      "type": "string",
      "description": "Staff user ID who created this"
    },
    "created_by_name": {
      "type": "string",
      "description": "Name of staff user who created this"
    },
    "transferred_pallet_id": {
      "type": "string",
      "description": "FK to BeltaBargainsPallet if transferred"
    },
    "transferred_at": {
      "type": "string",
      "format": "date-time",
      "description": "When item was transferred to pallet"
    }
  },
  "required": [
    "title",
    "product_code",
    "cost_price"
  ]
}