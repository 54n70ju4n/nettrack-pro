{
  "name": "EbayRefund",
  "type": "object",
  "properties": {
    "ebay_order_row_id": {
      "type": "string",
      "description": "FK to EbayOrder"
    },
    "ebay_order_id": {
      "type": "string"
    },
    "ebay_line_item_id": {
      "type": "string"
    },
    "refund_date_time": {
      "type": "string",
      "format": "date-time"
    },
    "refund_amount": {
      "type": "number"
    },
    "reason": {
      "type": "string"
    },
    "restocked": {
      "type": "boolean",
      "default": false
    },
    "restocked_to_status": {
      "type": "string",
      "enum": [
        "Returned",
        "Unlisted"
      ],
      "default": "Returned"
    },
    "notes": {
      "type": "string"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    },
    "deleted_by_user_id": {
      "type": "string"
    }
  },
  "required": [
    "refund_date_time",
    "refund_amount"
  ]
}