{
  "name": "WhatnotItem",
  "type": "object",
  "properties": {
    "belta_id": {
      "type": "string",
      "description": "Unique Belta internal reference"
    },
    "title": {
      "type": "string",
      "description": "Item title/description"
    },
    "location": {
      "type": "string",
      "description": "Physical storage location"
    },
    "category": {
      "type": "string",
      "description": "Item category"
    },
    "source": {
      "type": "string",
      "enum": [
        "PalletBreakdown",
        "Swap",
        "Other"
      ],
      "description": "Where the item came from"
    },
    "condition_grade": {
      "type": "string",
      "enum": [
        "New",
        "LikeNew",
        "Good",
        "Fair",
        "ForParts"
      ],
      "description": "Item condition"
    },
    "status": {
      "type": "string",
      "enum": [
        "PREP",
        "IN_SHOW",
        "SOLD",
        "SHIPPED",
        "UNSOLD",
        "CANCELLED"
      ],
      "default": "PREP",
      "description": "Current workflow status"
    },
    "show_lot_number": {
      "type": "string",
      "description": "Show lot/item number (e.g. #21) assigned during the show"
    },
    "item_cost": {
      "type": "number",
      "description": "Cost basis for profit calculation",
      "default": 0
    },
    "start_price": {
      "type": "number",
      "description": "Starting auction price for the show"
    },
    "sold_price": {
      "type": "number",
      "description": "What the customer paid on Whatnot"
    },
    "product_earnings": {
      "type": "number",
      "description": "What Whatnot pays out to seller (after fees deducted by Whatnot)",
      "default": 0
    },
    "whatnot_fees": {
      "type": "number",
      "default": 0,
      "description": "Whatnot platform fees (legacy field)"
    },
    "postage_cost": {
      "type": "number",
      "default": 0,
      "description": "Actual postage cost (legacy field)"
    },
    "other_costs": {
      "type": "number",
      "default": 0
    },
    "show_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the Whatnot show"
    },
    "show_name": {
      "type": "string",
      "description": "Name or reference for the show"
    },
    "buyer_username": {
      "type": "string",
      "description": "Whatnot buyer username (legacy field)"
    },
    "sold_at": {
      "type": "string",
      "format": "date-time"
    },
    "shipped_at": {
      "type": "string",
      "format": "date-time"
    },
    "tracking_number": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Item photos"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "belta_id",
    "title",
    "status"
  ]
}