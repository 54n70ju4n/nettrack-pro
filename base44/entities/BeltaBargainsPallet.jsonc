{
  "name": "BeltaBargainsPallet",
  "type": "object",
  "properties": {
    "pallet_id": {
      "type": "string",
      "description": "Unique pallet ID (format: BBB-T00001)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Transferred",
        "Completed"
      ],
      "default": "Transferred",
      "description": "Pallet status"
    },
    "created_by_user_id": {
      "type": "string",
      "description": "Staff user ID who created this"
    },
    "created_by_name": {
      "type": "string",
      "description": "Name of staff user who created this"
    },
    "total_cost_price": {
      "type": "number",
      "description": "Sum of all item cost prices"
    },
    "pdf_url": {
      "type": "string",
      "description": "URL to generated transfer sheet PDF"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes"
    },
    "payment_received_at": {
      "type": "string",
      "format": "date-time",
      "description": "When payment was confirmed"
    },
    "payment_received_by_user_id": {
      "type": "string",
      "description": "Staff user ID who confirmed payment"
    },
    "payment_received_by_name": {
      "type": "string",
      "description": "Name of staff user who confirmed payment"
    },
    "invoice_id": {
      "type": "string",
      "description": "FK to Invoice"
    },
    "invoice_url": {
      "type": "string",
      "description": "URL to invoice PDF"
    },
    "sale_id": {
      "type": "string",
      "description": "FK to PalletSale (revenue record)"
    }
  },
  "required": [
    "pallet_id",
    "total_cost_price"
  ]
}