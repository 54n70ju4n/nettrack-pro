{
  "name": "LabelTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre de la plantilla de rótulos"
    },
    "config": {
      "type": "object",
      "description": "Configuración completa del rótulo (hoja, recuadro, texto y campos)",
      "properties": {
        "sheet": { "type": "string" },
        "customW": { "type": "number" },
        "customH": { "type": "number" },
        "orientation": { "type": "string" },
        "marginTop": { "type": "number" },
        "marginRight": { "type": "number" },
        "marginBottom": { "type": "number" },
        "marginLeft": { "type": "number" },
        "columns": { "type": "number" },
        "rows": { "type": "number" },
        "gapX": { "type": "number" },
        "gapY": { "type": "number" },
        "copies": { "type": "number" },
        "showBorder": { "type": "boolean" },
        "borderWidth": { "type": "number" },
        "borderColor": { "type": "string" },
        "cornerRadius": { "type": "number" },
        "bgColor": { "type": "string" },
        "padding": { "type": "number" },
        "textColor": { "type": "string" },
        "nameFontSize": { "type": "number" },
        "metaFontSize": { "type": "number" },
        "bold": { "type": "boolean" },
        "align": { "type": "string" },
        "fields": {
          "type": "object",
          "properties": {
            "floor": { "type": "boolean" },
            "space": { "type": "boolean" },
            "deviceType": { "type": "boolean" },
            "patchPanel": { "type": "boolean" },
            "switchPort": { "type": "boolean" },
            "vlan": { "type": "boolean" },
            "technician": { "type": "boolean" }
          }
        }
      }
    }
  },
  "required": [
    "name"
  ]
}
