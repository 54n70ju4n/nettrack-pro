{
  "name": "PolandSupplier",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Supplier display name"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Inactive suppliers are hidden from selectors but kept for historical records"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}