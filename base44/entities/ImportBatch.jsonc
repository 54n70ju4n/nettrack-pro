{
  "name": "ImportBatch",
  "type": "object",
  "properties": {
    "import_type": {
      "type": "string",
      "enum": [
        "CSV_Orders",
        "CSV_Payouts"
      ]
    },
    "file_name": {
      "type": "string"
    },
    "total_rows": {
      "type": "number"
    },
    "imported_rows": {
      "type": "number"
    },
    "duplicate_rows": {
      "type": "number"
    },
    "error_rows": {
      "type": "number"
    },
    "column_mapping": {
      "type": "string"
    },
    "created_by_user_id": {
      "type": "string"
    }
  },
  "required": [
    "import_type"
  ]
}