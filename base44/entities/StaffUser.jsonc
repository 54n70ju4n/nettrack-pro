{
  "name": "StaffUser",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "User's display name"
    },
    "role": {
      "type": "string",
      "enum": [
        "OWNER",
        "STAFF",
        "DELIVERY_DRIVER"
      ],
      "description": "User role"
    },
    "pin_salt": {
      "type": "string",
      "description": "Random salt for PIN hashing"
    },
    "pin_hash": {
      "type": "string",
      "description": "SHA-256 hash of salt:pin"
    },
    "pin_hash_version": {
      "type": "string",
      "default": "sha256_v1",
      "description": "Hashing version for future-proofing"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    },
    "permissions": {
      "type": "object",
      "properties": {
        "can_view_admin_dashboard": {
          "type": "boolean",
          "default": false
        },
        "can_manage_users": {
          "type": "boolean",
          "default": false
        },
        "can_create_pallet": {
          "type": "boolean",
          "default": true
        },
        "can_edit_pallet": {
          "type": "boolean",
          "default": true
        },
        "can_create_pallet_sale": {
          "type": "boolean",
          "default": true
        },
        "can_edit_pallet_sale": {
          "type": "boolean",
          "default": true
        },
        "can_view_pallet_sales": {
          "type": "boolean",
          "default": true
        },
        "can_generate_invoices": {
          "type": "boolean",
          "default": true
        },
        "can_create_ebay_item": {
          "type": "boolean",
          "default": true
        },
        "can_edit_ebay_item": {
          "type": "boolean",
          "default": true
        },
        "can_import_ebay_csv": {
          "type": "boolean",
          "default": true
        },
        "can_edit_imported_ebay_orders": {
          "type": "boolean",
          "default": true
        },
        "can_create_refunds": {
          "type": "boolean",
          "default": true
        },
        "can_log_expense": {
          "type": "boolean",
          "default": true
        },
        "can_log_wages": {
          "type": "boolean",
          "default": true
        },
        "can_manage_appointment_slots": {
          "type": "boolean",
          "default": true
        },
        "can_approve_appointments": {
          "type": "boolean",
          "default": true
        },
        "can_export_data": {
          "type": "boolean",
          "default": true
        },
        "can_access_uk": {
          "type": "boolean",
          "default": true
        },
        "can_access_poland": {
          "type": "boolean",
          "default": false
        },
        "default_operation_area": {
          "type": "string",
          "enum": [
            "UK",
            "POLAND"
          ],
          "default": "UK"
        },
        "can_view_global_admin": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "failed_login_attempts": {
      "type": "number",
      "default": 0
    },
    "locked_until": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "full_name",
    "role",
    "pin_salt",
    "pin_hash"
  ]
}