{
  "name": "BrandTheme",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Theme name (e.g. PrimeTeach Core, Big Feelings Series Theme)"
    },
    "series": {
      "type": "string",
      "description": "Training series this theme applies to, or 'Global' for all"
    },
    "color_palette": {
      "type": "string",
      "description": "Primary, secondary, accent, and background colors with hex values"
    },
    "typography": {
      "type": "string",
      "description": "Heading and body fonts, sizes, weights"
    },
    "layout_structure": {
      "type": "string",
      "description": "Slide layout patterns \u2014 title slide, content slide, section divider, activity slide"
    },
    "visual_style": {
      "type": "string",
      "description": "Overall visual direction \u2014 imagery style, iconography, spacing, decorative elements"
    },
    "slide_structure": {
      "type": "string",
      "description": "Standard slide anatomy \u2014 headline placement, body content zones, footer, page numbers"
    },
    "variation_notes": {
      "type": "string",
      "description": "How this theme should slightly vary per training while staying on-brand"
    },
    "source_slides": {
      "type": "string",
      "description": "Reference to uploaded slide files used to extract this theme"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this is the current active theme"
    }
  },
  "required": [
    "name"
  ]
}