{
  "name": "ComplianceAlert",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Alert title"
    },
    "source": {
      "type": "string",
      "enum": [
        "tac_746",
        "tecpds",
        "cda_council",
        "other"
      ],
      "default": "tac_746"
    },
    "source_url": {
      "type": "string",
      "description": "Link to primary source"
    },
    "change_description": {
      "type": "string",
      "description": "What changed"
    },
    "effective_date": {
      "type": "string",
      "format": "date",
      "description": "When the change takes effect"
    },
    "affected_modules": {
      "type": "string",
      "description": "List of affected training modules"
    },
    "suggested_priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "recommended_action": {
      "type": "string",
      "description": "Suggested next steps"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "in_review",
        "resolved",
        "no_action_needed"
      ],
      "default": "new"
    },
    "resolution_notes": {
      "type": "string",
      "description": "Notes on how this was resolved"
    }
  },
  "required": [
    "title",
    "change_description"
  ]
}