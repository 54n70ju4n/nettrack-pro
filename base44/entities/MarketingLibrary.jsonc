{
  "name": "MarketingLibrary",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Asset title or name"
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "social_post",
        "social_post_template",
        "email_subject_line",
        "email_campaign",
        "newsletter",
        "campaign_brief",
        "landing_page",
        "brand_messaging",
        "strategy"
      ],
      "default": "social_post_template",
      "description": "Type of marketing asset"
    },
    "channel": {
      "type": "string",
      "enum": [
        "linkedin",
        "facebook",
        "instagram",
        "email",
        "newsletter",
        "website",
        "general"
      ],
      "default": "general",
      "description": "Marketing channel this asset belongs to"
    },
    "content": {
      "type": "string",
      "description": "Full asset content \u2014 post copy, subject line, email HTML, campaign brief, messaging pillar, etc."
    },
    "post_type": {
      "type": "string",
      "description": "For social posts \u2014 the post type classification"
    },
    "tags": {
      "type": "string",
      "description": "Comma-separated tags for searchability (e.g. hiring, CDA, director, enrollment)"
    },
    "source_record_id": {
      "type": "string",
      "description": "ID of the original SocialPost or EmailCampaign this asset was archived from"
    },
    "source_entity": {
      "type": "string",
      "enum": [
        "SocialPost",
        "EmailCampaign",
        "manual"
      ],
      "default": "manual",
      "description": "Which entity this library asset was derived from"
    },
    "marketing_goal": {
      "type": "string",
      "description": "Which PrimeTeach marketing goal this asset supports"
    },
    "performance_summary": {
      "type": "string",
      "description": "How this asset performed \u2014 engagement, opens, clicks, results"
    },
    "lessons_learned": {
      "type": "string",
      "description": "What worked, what could be improved \u2014 Sol's post-approval evaluation"
    },
    "improvement_notes": {
      "type": "string",
      "description": "Recommended updates and refinements for future reuse"
    },
    "coaching_notes": {
      "type": "string",
      "description": "Executive coaching feedback from Atlas on this asset or strategy"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived",
        "draft"
      ],
      "default": "active",
      "description": "Whether this asset is currently in active use"
    },
    "is_template": {
      "type": "boolean",
      "default": false,
      "description": "True if this is a reusable template rather than a one-off asset"
    }
  },
  "required": [
    "title",
    "asset_type"
  ]
}