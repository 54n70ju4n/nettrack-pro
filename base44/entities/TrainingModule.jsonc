{
  "name": "TrainingModule",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Module title"
    },
    "series": {
      "type": "string",
      "description": "Training series name (e.g. Big Feelings, Strong Foundations)"
    },
    "module_number": {
      "type": "number",
      "description": "Module number within the series"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_review",
        "approved",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "assigned_trainer": {
      "type": "string",
      "description": "Trainer name (Nichelle, Tiffany, Terri, Connie)"
    },
    "target_audience": {
      "type": "string",
      "enum": [
        "teacher",
        "administrator",
        "both"
      ],
      "default": "teacher"
    },
    "clock_hours": {
      "type": "number",
      "description": "Clock hours for the training"
    },
    "learning_objectives": {
      "type": "string",
      "description": "Learning objectives for the module"
    },
    "cda_competency_goals": {
      "type": "string",
      "description": "CDA Competency Goals addressed"
    },
    "tecpds_competency_areas": {
      "type": "string",
      "description": "TECPDS core competency areas addressed"
    },
    "tac_standards": {
      "type": "string",
      "description": "Texas Minimum Standards (TAC \u00a7746) referenced"
    },
    "script_content": {
      "type": "string",
      "description": "Trainer script content"
    },
    "slide_content": {
      "type": "string",
      "description": "Slide deck content outline"
    },
    "slides_url": {
      "type": "string",
      "description": "Google Slides or Canva presentation URL for this module's deck"
    },
    "references": {
      "type": "string",
      "description": "Annotated reference list with citations"
    },
    "handouts": {
      "type": "string",
      "description": "Learner handout content"
    },
    "review_summary": {
      "type": "string",
      "description": "What-to-review summary flagging citations and compliance claims"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "revision_notes": {
      "type": "string",
      "description": "Edit feedback from Nichelle when a module is sent back for revisions"
    }
  },
  "required": [
    "title"
  ]
}