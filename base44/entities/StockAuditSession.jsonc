{
  "name": "StockAuditSession",
  "type": "object",
  "properties": {
    "session_date": {
      "type": "string",
      "format": "date",
      "description": "Date the audit session was started"
    },
    "audited_by_user_id": {
      "type": "string",
      "description": "FK to StaffUser"
    },
    "audited_by_name": {
      "type": "string",
      "description": "Display name of the staff member"
    },
    "status": {
      "type": "string",
      "enum": [
        "InProgress",
        "Completed"
      ],
      "default": "InProgress"
    },
    "checked_count": {
      "type": "number",
      "default": 0
    },
    "missing_count": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "session_date"
  ]
}