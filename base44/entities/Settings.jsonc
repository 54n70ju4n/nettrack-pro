{
  "name": "Settings",
  "type": "object",
  "properties": {
    "business_name": {
      "type": "string",
      "default": "Belta Bulk"
    },
    "business_address": {
      "type": "string"
    },
    "business_phone": {
      "type": "string"
    },
    "business_email": {
      "type": "string"
    },
    "vat_registered": {
      "type": "boolean",
      "default": false
    },
    "vat_number": {
      "type": "string"
    },
    "appointment_opening_hours_enabled": {
      "type": "boolean",
      "default": true
    },
    "appointment_open_time": {
      "type": "string",
      "default": "09:00"
    },
    "appointment_close_time": {
      "type": "string",
      "default": "17:00"
    },
    "appointment_slot_length_minutes": {
      "type": "number",
      "default": 30
    },
    "appointment_max_per_day": {
      "type": "number",
      "default": 6
    },
    "appointment_buffer_minutes": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "GBP"
    }
  },
  "required": []
}