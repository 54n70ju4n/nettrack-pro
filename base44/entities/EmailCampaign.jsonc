{
  "name": "EmailCampaign",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Campaign name"
    },
    "subject": {
      "type": "string",
      "description": "Email subject line"
    },
    "preview_text": {
      "type": "string",
      "description": "Preview text shown in the inbox before opening"
    },
    "from_email": {
      "type": "string",
      "description": "Sender email address"
    },
    "from_name": {
      "type": "string",
      "description": "Sender display name"
    },
    "html_content": {
      "type": "string",
      "description": "Full HTML body of the email"
    },
    "group_id": {
      "type": "string",
      "description": "MailerLite subscriber group ID to send to"
    },
    "group_name": {
      "type": "string",
      "description": "Display name of the subscriber group"
    },
    "mailerlite_campaign_id": {
      "type": "string",
      "description": "MailerLite campaign ID once the draft has been created"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_approval",
        "approved",
        "sent"
      ],
      "default": "pending_approval",
      "description": "Approval and send status"
    },
    "campaign_goal": {
      "type": "string",
      "description": "Which PrimeTeach marketing goal this campaign supports"
    },
    "source_training": {
      "type": "string",
      "description": "Training module this campaign repurposes, if any"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "revision_notes": {
      "type": "string",
      "description": "Edit feedback from Nichelle when a campaign is sent back for revisions"
    }
  },
  "required": [
    "title",
    "subject"
  ]
}