{
  "name": "PalletReturn",
  "type": "object",
  "properties": {
    "return_code": {
      "type": "string",
      "description": "Unique return reference (e.g. RET-000001)"
    },
    "sale_id": {
      "type": "string",
      "description": "FK to PalletSale"
    },
    "sale_code": {
      "type": "string",
      "description": "Sale reference code (copied for display)"
    },
    "customer_name": {
      "type": "string"
    },
    "return_date": {
      "type": "string",
      "format": "date-time"
    },
    "returned_pallet_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of Pallet record IDs that were returned"
    },
    "returned_pallet_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of human-readable pallet IDs (e.g. BBK-P000123)"
    },
    "reason": {
      "type": "string",
      "enum": [
        "CustomerRequest",
        "Damaged",
        "WrongItem",
        "ChangeOfMind",
        "Other"
      ]
    },
    "reason_notes": {
      "type": "string"
    },
    "refund_amount": {
      "type": "number",
      "default": 0
    },
    "refund_method": {
      "type": "string",
      "enum": [
        "Cash",
        "Card",
        "BankTransfer"
      ]
    },
    "is_full_return": {
      "type": "boolean",
      "default": false,
      "description": "True if all pallets in the sale were returned"
    },
    "processed_by_user_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "return_code",
    "sale_id",
    "return_date",
    "reason",
    "refund_amount"
  ]
}