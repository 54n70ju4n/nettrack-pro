{
  "name": "ActivityLog",
  "type": "object",
  "properties": {
    "actor_user_id": {
      "type": "string",
      "description": "StaffUser ID who performed the action"
    },
    "actor_name": {
      "type": "string",
      "description": "Name of the actor at time of action"
    },
    "actor_role": {
      "type": "string",
      "description": "Role of the actor at time of action"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "USER_LOGIN_SUCCESS",
        "USER_LOGIN_FAILED",
        "PIN_AUTH_ATTEMPT",
        "PALLET_CREATED",
        "PALLET_STATUS_CHANGED",
        "PALLET_RESERVED",
        "PALLET_RESERVATION_REVERSED",
        "SALE_CREATED",
        "DISPATCH_CREATED",
        "DELIVERY_COMPLETED",
        "APPOINTMENT_APPROVED",
        "APPOINTMENT_REJECTED",
        "EBAY_BOX_CHECKED",
        "EBAY_ITEM_CREATED",
        "EBAY_ITEM_UPDATED",
        "EBAY_ITEM_DELETED",
        "EBAY_ITEM_UNLISTABLE",
        "EBAY_LISTED",
        "TARGET_CREATED",
        "TARGET_UPDATED",
        "FINANCIAL_DATA_EDITED"
      ],
      "description": "Type of action performed"
    },
    "entity_type": {
      "type": "string",
      "description": "Entity type affected (e.g. 'EbayItem', 'Pallet')"
    },
    "entity_id": {
      "type": "string",
      "description": "ID of the entity affected"
    },
    "entity_label": {
      "type": "string",
      "description": "Human-readable label (e.g. 'B-001234', 'BBK-P000123')"
    },
    "message": {
      "type": "string",
      "description": "Human-readable description of action"
    },
    "metadata": {
      "type": "object",
      "description": "Additional context as JSON"
    },
    "is_system": {
      "type": "boolean",
      "default": false,
      "description": "Whether this was a system-generated action"
    }
  },
  "required": [
    "action_type",
    "message"
  ]
}