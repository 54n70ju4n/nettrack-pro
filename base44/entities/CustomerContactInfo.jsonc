{
  "name": "CustomerContactInfo",
  "type": "object",
  "properties": {
    "phone": {
      "type": "string",
      "description": "Customer phone number (unique key)"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer name"
    },
    "last_contacted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the WhatsApp button was last tapped"
    }
  },
  "required": [
    "phone"
  ]
}