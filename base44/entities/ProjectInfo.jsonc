{
  "name": "ProjectInfo",
  "type": "object",
  "properties": {
    "project_name": {
      "type": "string",
      "description": "Nombre del proyecto"
    },
    "client": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "address": {
      "type": "string",
      "description": "Dirección del proyecto"
    },
    "city": {
      "type": "string",
      "description": "Ciudad / ubicación"
    },
    "url": {
      "type": "string",
      "description": "URL o sitio del proyecto"
    },
    "phone": {
      "type": "string",
      "description": "Teléfono de contacto"
    },
    "email": {
      "type": "string",
      "description": "Correo de contacto"
    },
    "contact_name": {
      "type": "string",
      "description": "Persona de contacto"
    },
    "logo_url": {
      "type": "string",
      "description": "URL del logo/imagen del proyecto"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de inicio"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de finalización estimada"
    },
    "status": {
      "type": "string",
      "enum": [
        "activo",
        "en_pausa",
        "finalizado"
      ],
      "default": "activo",
      "description": "Estado del proyecto"
    },
    "description": {
      "type": "string",
      "description": "Descripción general del proyecto"
    },
    "primary_color": {
      "type": "string",
      "description": "Color de marca (hex) aplicado a la app y al PDF de este proyecto"
    },
    "hidden_modules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Módulos ocultos para este proyecto (ej: puntos, rotulos, plantillas)"
    },
    "terminology": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Renombres de terminología {clave: etiqueta} (ej: {point: 'Nodo'})"
    },
    "pin_color": {
      "type": "string",
      "description": "Color fijo (hex) de los pines sobre el plano. Vacío = color según el estado del punto"
    },
    "pin_opacity": {
      "type": "number",
      "default": 100,
      "description": "Opacidad del relleno de los pines (0-100). 0 = relleno transparente, solo contorno"
    },
    "pin_border_opacity": {
      "type": "number",
      "default": 100,
      "description": "Opacidad del contorno de los pines (0-100). 0 = contorno transparente"
    }
  },
  "required": [
    "project_name"
  ]
}
