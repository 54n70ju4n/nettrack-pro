{
  "name": "Technician",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del t\u00e9cnico"
    },
    "specialty": {
      "type": "string",
      "enum": [
        "redes",
        "cctv",
        "wifi",
        "general"
      ],
      "default": "general",
      "description": "Especialidad del t\u00e9cnico"
    },
    "phone": {
      "type": "string",
      "description": "Tel\u00e9fono de contacto"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Si el t\u00e9cnico est\u00e1 activo"
    }
  },
  "required": [
    "name"
  ]
}