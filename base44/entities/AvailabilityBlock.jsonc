{
  "name": "AvailabilityBlock",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of availability"
    },
    "start_time": {
      "type": "string",
      "description": "Start time (HH:MM format)"
    },
    "end_time": {
      "type": "string",
      "description": "End time (HH:MM format)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Available",
        "Unavailable"
      ],
      "default": "Available"
    },
    "max_bookings": {
      "type": "number",
      "default": 1,
      "description": "Maximum number of bookings allowed in this block"
    },
    "bookings_count": {
      "type": "number",
      "default": 0,
      "description": "Current count of approved bookings"
    },
    "notes": {
      "type": "string"
    },
    "created_by_user_id": {
      "type": "string"
    },
    "updated_by_user_id": {
      "type": "string"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "date",
    "start_time",
    "end_time"
  ]
}