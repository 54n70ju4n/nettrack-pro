{
  "name": "TruckLoadType",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name of the load type (e.g. Outsunny)"
    },
    "collection_postcode": {
      "type": "string",
      "description": "Postcode for collection (shown to the shipping company)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this load type appears in the customer form"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "use_jagar_shipping": {
      "type": "boolean",
      "default": false,
      "description": "If true, enquiries for this load type go to the Jagar Shipping dashboard (ShippingQuote status)"
    },
    "delivery_included_from_supplier": {
      "type": "boolean",
      "default": false,
      "description": "If true, delivery is included from the supplier \u2014 skip shipping dashboard and go straight to ToQuote. Also hides Collection option on the enquiry form."
    }
  },
  "required": [
    "name"
  ]
}